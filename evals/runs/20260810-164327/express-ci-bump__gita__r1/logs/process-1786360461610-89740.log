        "buildIds": {
          "default": null,
          "description": "For 'list': Array of build IDs to retrieve. MUTUALLY EXCLUSIVE with all other filter parameters (definitions, queues, branchName, statusFilter, resultFilter, tagFilters, ...). Must be a JSON array of integers, e.g. [123, 456]."
