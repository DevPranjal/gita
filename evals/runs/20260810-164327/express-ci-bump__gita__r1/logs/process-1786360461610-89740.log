    "name": "ado-wit_query",
    "namespacedName": "ado/wit_query",
    "source": "mcp",
    "title": "wit_query",
    "description": "Read operations on Azure DevOps work item queries. Use 'action' to choose: 'get' (a query by ID or path), 'get_results' (the results of a query by query ID), 'search' (search all queries accessible to the user by filter text), 'list' (list root query folders and their children for a project).",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'get', 'get_results', 'search', 'list'.",
          "type": "string"
        },
        "depth": {
          "default": null,
          "description": "For 'get': How deep to expand the query. Defaults to 0. For 'list': Depth of children to fetch within query folders. Defaults to 1."
        },
        "expand": {
          "default": null,
          "description": "For 'get', 'list' and 'search': Optional expand parameter for query details. Allowed values: 'None' (columns, links, changeInfo), 'Wiql' (adds WIQL text), 'Clauses' (adds WIQL clauses), 'All' (all properties), 'Minimal' (minimal properties and WIQL text)."
        },
        "filter": {
          "default": null,
          "description": "For 'search': Required. The text to filter queries by name.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "default": null,
          "description": "For 'get_results': The ID (GUID) of the query to retrieve results for."
        },
        "includeDeleted": {
          "default": null,
          "description": "For 'get', 'list' and 'search': Whether to include deleted items. Defaults to false."
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "The name or ID of the Azure DevOps project. Required for all actions.",
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "default": null,
          "description": "For 'get': The ID or path of the query to retrieve.",
          "type": [
            "string",
            "null"
          ]
        },
        "team": {
          "default": null,
          "description": "For 'get_results': The team name or ID. If not provided, the default team is used.",
          "type": [
            "string",
            "null"
          ]
        },
        "timePrecision": {
          "default": null,
          "description": "For 'get_results': Whether to include time precision. Defaults to false."
        },
        "top": {
          "default": null,
          "description": "For 'get_results': Maximum number of results. Defaults to 50. For 'search': Maximum number of queries to return. Defaults to 50, maximum is 200."
        },
        "useIsoDateFormat": {
          "default": null,
          "description": "For 'get': Whether to use ISO date format. Defaults to false."
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "wit_query",
    "readOnly": true,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-wit_work_item",
    "namespacedName": "ado/wit_work_item",
    "source": "mcp",
    "title": "wit_work_item",
    "description": "Read operations on Azure DevOps work items. Use 'action' to choose: 'get' (single work item by ID), 'get_batch' (multiple work items by IDs), 'list_comments' (comments on a work item), 'my' (work items relevant to the authenticated user), 'list_revisions' (revisions of a work item), 'list_for_iteration' (work items for a team iteration), 'get_type' (metadata for a work item type).",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'get', 'get_batch', 'list_comments', 'my', 'list_revisions', 'list_for_iteration', 'get_type'.",
          "type": "string"
        },
        "asOf": {
          "default": null,
          "description": "For 'get': Optional date string to retrieve the work item as of a specific time."
        },
        "expand": {
          "default": null,
          "description": "For 'get', 'get_batch', 'list_revisions': Expand options ('All', 'Fields', 'Links', 'None', 'Relations'). For 'get' and 'get_batch', cannot be used with fields."
        },
        "fields": {
          "default": null,
          "description": "For 'get', 'get_batch': Optional list of fields to include. For 'get' and 'get_batch', cannot be used together with the expand parameter."
        },
        "id": {
          "default": null,
          "description": "For 'get': The ID of the work item to retrieve."
        },
        "ids": {
          "default": null,
          "description": "For 'get_batch': The IDs of the work items to retrieve. Must be a JSON array of integers, e.g. [123, 456]."
        },
        "includeCompleted": {
          "default": null,
          "description": "For 'my': Whether to include completed work items. Defaults to false."
        },
        "iterationId": {
          "default": null,
          "description": "For 'list_for_iteration': The ID of the iteration to retrieve work items for."
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "The name or ID of the Azure DevOps project. Required for all actions.",
          "type": [
            "string",
            "null"
          ]
        },
        "skip": {
          "default": null,
          "description": "For 'list_revisions': Number of revisions to skip for pagination."
        },
        "team": {
          "default": null,
          "description": "For 'list_for_iteration': The name or ID of the team. If not provided, the default team is used.",
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "default": null,
          "description": "For 'list_comments', 'list_revisions', 'my': Maximum number of results."
        },
        "type": {
          "default": null,
          "description": "For 'my': The type of work items to retrieve.",
          "enum": [
            "assignedtome",
            "myactivity"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "workItemId": {
          "default": null,
          "description": "For 'list_comments', 'list_revisions': The ID of the work item."
        },
        "workItemType": {
          "default": null,
          "description": "For 'get_type': The name of the work item type to retrieve.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "wit_work_item",
    "readOnly": true,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-wit_work_item_attachment",
    "namespacedName": "ado/wit_work_item_attachment",
    "source": "mcp",
    "title": "wit_work_item_attachment",
    "description": "Download a work item attachment by its ID. Returns the attachment content as an embedded resource with the appropriate MIME type. Useful for viewing images (e.g. screenshots) or other files attached to work items.",
    "input_schema": {
      "properties": {
        "attachmentId": {
          "description": "The GUID of the attachment. Found in the attachment URL."
        },
        "fileName": {
          "default": null,
          "description": "The file name of the attachment, e.g. 'screenshot.png'. Used to determine the MIME type.",
          "type": [
            "string",
            "null"
          ]
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "The name or ID of the Azure DevOps project.",
          "type": "string"
        }
      },
      "required": [
        "project",
        "attachmentId"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "wit_work_item_attachment",
    "readOnly": true,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-wit_work_item_comment_write",
    "namespacedName": "ado/wit_work_item_comment_write",
    "source": "mcp",
    "title": "wit_work_item_comment_write",
    "description": "Write operations on work item comments. Use 'action' to choose: 'add' (add a new comment), 'update' (update an existing comment).",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'add', 'update'.",
