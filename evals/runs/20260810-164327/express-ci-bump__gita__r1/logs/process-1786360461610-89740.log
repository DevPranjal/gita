  {
    "name": "icm-search_teams_or_services",
    "namespacedName": "icm/search_teams_or_services",
    "source": "mcp",
    "title": "Search Teams or Services",
    "description": "Search for ICM teams or services using V3 Smart Search (Azure AI Search). Usage: (1) Text search — provide searchString to find teams by name, service, or Azure offering. (2) Service-scoped browse — provide serviceId to list teams within a specific service (searchString optional). (3) Filters — narrow results by on-call status, assignability, or virtual team type.",
    "input_schema": {
      "properties": {
        "request": {
          "description": "Search request for ICM teams or services using V3 Smart Search (Azure AI Search).",
          "properties": {
            "assignableOnly": {
              "description": "Only return teams that accept incident assignments. Set to true to exclude non-assignable teams.",
              "type": "boolean"
            },
            "nonVirtualTeamsOnly": {
              "description": "Exclude virtual/redirect teams, return only real teams.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "searchString": {
              "description": "Search query — team name, service name, or Azure offering (e.g., 'Azure Monitor', 'IcM DRI', 'Cosmos DB').",
              "type": "string"
            },
            "serviceId": {
              "description": "Filter results to a specific IcM service ID. Use 0 or omit to search across all services.",
              "type": "integer"
            },
            "skip": {
              "description": "Number of results to skip for pagination (default: 0).",
              "type": "integer"
            },
            "teamId": {
              "description": "Filter results to a specific IcM team ID. Use 0 or omit to search across all teams.",
              "type": "integer"
            },
            "top": {
              "description": "Max results to return (default: 10, max: 100).",
              "type": "integer"
            },
            "virtualTeamsOnly": {
              "description": "Only return virtual/redirect teams. Set to true to filter to virtual teams only.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "withAzureOffering": {
              "description": "Include Azure offering/product name in search results. Defaults to true for richer context.",
              "type": "boolean"
            },
            "withOnCallRotationsOnly": {
              "description": "Only return teams with active on-call schedules. Set to true to filter out teams without on-call rotations.",
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    },
