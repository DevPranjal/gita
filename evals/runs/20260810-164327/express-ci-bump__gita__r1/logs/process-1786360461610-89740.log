          "description": "If true, only search user's own services (default: false).",
          "type": "boolean"
        },
        "query": {
          "description": "Service/team/org name or partial match (case-insensitive).",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "mcpServerName": "enghub",
    "mcpToolName": "resolve_service",
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "enghub-search",
    "namespacedName": "enghub/search",
    "source": "mcp",
    "title": "search",
    "description": "Search EngineeringHub (eng.ms) for documentation, TSGs, and knowledge articles.\n\nReturns ranked results with title, URL, type, service, and date. Use fetch to get full page content.\n\nScoping behavior:\n- Default (autoScope=true): auto-detects service from query text using user's services.\n- scope: manual override. All scope fields AND-combined. Overrides autoScope.\n- autoScope=false: pure text search, no service scoping.\n\nWhen scoped results are sparse, automatically appends unscoped \"helper\" results (deduplicated).\n\nWorkflow:\n1. resolve_service → get serviceIds/ancestorId\n2. search with scope.serviceIds or scope.ancestorId + scope.nodeTypes for targeted results\n3. fetch any result URL for full content",
    "input_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "autoScope": {
          "description": "Auto-detect service from query (default: true). Set false for unscoped text search.",
          "type": "boolean"
        },
        "query": {
          "description": "Search query text.",
          "type": "string"
        },
        "scope": {
          "additionalProperties": false,
          "description": "Manual scope. Overrides autoScope. All fields AND-combined.",
          "properties": {
            "ancestorId": {
              "description": "Metadata node GUID (NOT ServiceTree ID): limit to descendants of this node.",
              "type": "string"
            },
            "nodeId": {
              "description": "Metadata node GUID (NOT ServiceTree ID): limit to content within this subtree.",
              "type": "string"
            },
            "nodeTypes": {
              "description": "Filter by Standard content tags. Valid: 'TSGs', 'Team Docs', 'Onboarding Guides', 'OpenAPI', 'Popular', 'Featured'. Fuzzy prefix supported: 'TSG'->'TSGs', 'Onboard'->'Onboarding Guides'.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "serviceIds": {
              "description": "ServiceTree GUIDs (Service-level only, OR-combined). Limit to content tagged with these services.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "urlPath": {
              "description": "eng.ms URL or path to scope search to a subtree (e.g., 'https://eng.ms/docs/products/arm'). Resolved to a metadata node for filtering.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "top": {
          "description": "Max results (default: 10).",
          "type": "number"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "mcpServerName": "enghub",
    "mcpToolName": "search",
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
