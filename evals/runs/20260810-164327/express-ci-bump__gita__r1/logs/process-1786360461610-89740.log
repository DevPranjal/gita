  {
    "name": "icm-mitigate_incident",
    "namespacedName": "icm/mitigate_incident",
    "source": "mcp",
    "title": "mitigate_incident",
    "description": "Mitigate an active incident. Input requires incidentId, mitigateContactAlias, mitigation, howFixed, isCustomerImpacting, and isNoise; mitigationStartTime (TTIM) may be required for qualifying outages. Returns IncidentActionResult, including PartialSuccess when mitigation succeeds but TTIM persistence fails.",
    "input_schema": {
      "properties": {
        "request": {
          "properties": {
            "howFixed": {
              "description": "How the incident was fixed. Common values: By Design, Customer Error, External, False Alarm, False Alarm/Transient, Fixed By Automation, Fixed with Ad-Hoc steps, Fixed with Hotfix, Fixed with TSG, Other, Transient, Unable to reproduce, Won't Fix.",
              "type": "string"
            },
            "incidentId": {
              "description": "Please provide numeric incident id, like 626495494.",
              "type": "integer"
            },
            "isCustomerImpacting": {
              "description": "Whether the incident is customer impacting. Required — matches Portal which forces an explicit user choice (true/false).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "isNoise": {
              "description": "Whether the incident is noise. Required — matches Portal which forces an explicit user choice (true/false).",
              "type": [
                "boolean",
                "null"
              ]
            },
            "mitigateContactAlias": {
              "description": "Please provide the alias of the contact performing the mitigation. Must match the authenticated user for user tokens; for MSI/app tokens any valid alias is accepted.",
              "type": "string"
            },
            "mitigation": {
              "description": "Description of how the incident was mitigated.",
              "type": "string"
            },
            "mitigationStartTime": {
              "description": "ISO-8601 timestamp recording when mitigation was identified (TTIM). Outage-only: required only when the incident is an outage and its FrontEnd Category exposes a MitigationStartTime custom field; will be elicited from the user otherwise. Must be between the incident acknowledge time and the current time.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "mitigationTimeStamp": {
              "description": "ISO-8601 timestamp for when the incident was mitigated (Portal 'Time mitigated'), e.g. 2025-07-01T01:00:00Z. Optional; defaults to now. Distinct from the TTIM/MitigationStartTime field.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "rootCauseNeedsInvestigation": {
              "description": "Whether the root cause still needs investigation (Portal 'Root cause needs investigation'). Optional; defaults to true when omitted.",
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "mitigateContactAlias",
            "mitigation",
            "howFixed",
            "isCustomerImpacting",
            "isNoise",
            "incidentId"
          ],
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    },
    "mcpServerName": "icm",
    "mcpToolName": "mitigate_incident",
    "readOnly": false,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
