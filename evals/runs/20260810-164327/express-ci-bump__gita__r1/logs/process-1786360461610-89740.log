  {
    "name": "ado-repo_pull_request",
    "namespacedName": "ado/repo_pull_request",
    "source": "mcp",
    "title": "repo_pull_request",
    "description": "Read operations on Azure DevOps pull requests. Use 'action' to choose: 'get' [requires repositoryId, pullRequestId, project] — get a PR by ID; 'list' [requires repositoryId OR project] — list PRs with optional filters; 'list_by_commits' [requires project, repository, commits] — find PRs containing the given commits; 'get_changes' [requires repositoryId, pullRequestId] — get file changes and line-by-line diffs for a PR iteration.",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'get', 'list', 'list_by_commits', 'get_changes'.",
          "type": "string"
        },
        "commits": {
          "default": null,
          "description": "For 'list_by_commits': Array of commit IDs to query for."
        },
        "compareTo": {
          "default": null,
          "description": "For 'get_changes': Iteration ID to compare against. If specified, returns changes between the two iterations."
        },
        "createdByMe": {
          "default": false,
          "description": "For 'list': Filter pull requests created by the current user. Ignored if createdByUser is provided."
        },
        "createdByUser": {
          "default": null,
          "description": "For 'list': Filter pull requests created by a specific user (provide email address). Takes precedence over createdByMe.",
          "type": [
            "string",
            "null"
          ]
        },
        "iAmReviewer": {
          "default": false,
          "description": "For 'list': Filter pull requests where the current user is a reviewer. Ignored if userIsReviewer is provided."
        },
        "includeDiffs": {
          "default": true,
          "description": "For 'get_changes': Whether to include actual line-by-line diff content. Default is true. Set to false to get only file metadata."
        },
        "includeLabels": {
          "default": false,
          "description": "For 'get': Whether to include a summary of labels in the response."
        },
        "includeLineContent": {
          "default": true,
          "description": "For 'get_changes': Whether to include actual line content from the changed files. Default is true. When true, fetches file content and includes the code lines that were added/removed/modified."
        },
        "includeWorkItemRefs": {
          "default": false,
          "description": "For 'get': Whether to reference work items associated with the pull request."
        },
        "iterationId": {
          "default": null,
          "description": "For 'get_changes': The iteration ID to get changes for. If not specified, gets changes for the latest iteration."
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "Required for 'get' and 'list_by_commits'. Optional for 'list' (scopes the search). Required for 'get_changes' and other actions when repositoryId is a repository name (not a GUID). Project ID or project name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pullRequestId": {
          "default": null,
          "description": "Required for 'get' and 'get_changes'. The ID of the pull request to retrieve."
        },
        "queryType": {
          "default": "LastMergeCommit",
          "description": "For 'list_by_commits': Type of query. 'LastMergeCommit' or 'Commit'.",
          "enum": [
            "LastMergeCommit",
            "Commit"
          ],
          "type": "string"
        },
        "repository": {
          "default": null,
          "description": "Required for 'list_by_commits'. The ID or name of the repository.",
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryId": {
          "default": null,
          "description": "Required for 'get' and 'get_changes'; optional for 'list' (used as a filter scope). For 'list_by_commits' use the 'repository' parameter instead. The ID or name of the repository. When a name is used, the project parameter must also be provided.",
          "type": [
            "string",
            "null"
          ]
        },
        "skip": {
          "default": 0,
          "description": "For 'list': The number of pull requests to skip. For 'get_changes': The number of file changes to skip for pagination."
        },
        "sourceRefName": {
          "default": null,
          "description": "For 'list': Filter pull requests from this source branch (e.g., 'refs/heads/feature-branch').",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
