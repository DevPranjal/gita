          "type": [
            "string",
            "null"
          ]
        },
        "isDraft": {
          "default": null,
          "description": "For 'create' (default false) and 'update' (nullable): Whether the pull request is a draft."
        },
        "labels": {
          "default": null,
          "description": "For 'create' (add labels) and 'update' (replace labels): Array of label names."
        },
        "mergeCommitMessage": {
          "default": null,
          "description": "For 'update': Commit message to use when the pull request is completed via autocomplete.",
          "type": [
            "string",
            "null"
          ]
        },
        "mergeStrategy": {
          "default": null,
          "description": "For 'update': Merge strategy to use when autocompleting. Defaults to 'NoFastForward'.",
          "enum": [
            "NoFastForward",
            "Squash",
            "Rebase",
            "RebaseMerge"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "Required for 'update'. Required for all other actions when repositoryId is a repository name (not a GUID). Project ID or project name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pullRequestId": {
          "default": null,
          "description": "Required for 'update', 'update_reviewers', 'vote'. The ID of the pull request."
        },
        "repositoryId": {
          "default": null,
          "description": "Required for all actions. The ID or name of the repository the pull request belongs to. When a name is used, the project parameter must also be provided.",
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerAction": {
          "default": null,
          "description": "Required for 'update_reviewers'. 'add' or 'remove' the listed reviewers.",
          "enum": [
            "add",
            "remove"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "reviewerIds": {
          "default": null,
          "description": "Required for 'update_reviewers'. List of reviewer IDs or email addresses to add or remove."
        },
        "sourceRefName": {
          "default": null,
