          ]
        },
        "commentId": {
          "default": null,
          "description": "For 'update': The ID of the comment to update."
        },
        "format": {
          "default": null,
          "description": "Format of the comment text. Defaults to 'Markdown'."
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "The name or ID of the Azure DevOps project.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "default": null,
          "description": "For 'update': The updated comment text.",
          "type": [
            "string",
            "null"
          ]
        },
        "workItemId": {
          "default": null,
          "description": "The ID of the work item."
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "wit_work_item_comment_write",
    "readOnly": false,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-wit_work_item_link_write",
    "namespacedName": "ado/wit_work_item_link_write",
    "source": "mcp",
    "title": "wit_work_item_link_write",
    "description": "Write operations on work item links. Use 'action' to choose: 'link' (link two work items), 'unlink' (remove links from a work item), 'link_to_pull_request' (link a work item to a pull request), 'add_artifact_link' (add a repository/branch/commit/build/wiki artifact link to a work item).",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'link', 'unlink', 'link_to_pull_request', 'add_artifact_link'.",
          "type": "string"
        },
        "artifactUri": {
          "default": null,
          "description": "For 'add_artifact_link': The complete VSTFS URI of the artifact. If provided, individual component parameters are ignored.",
          "type": [
            "string",
            "null"
          ]
        },
        "branchName": {
          "default": null,
          "description": "For 'add_artifact_link': The branch name. Required when linkType is 'Branch'.",
          "type": [
            "string",
            "null"
          ]
        },
        "buildId": {
          "default": null,
          "description": "For 'add_artifact_link': The build ID. Required when linkType is 'Build', 'Found in build', or 'Integrated in build'."
        },
        "comment": {
          "default": null,
          "description": "For 'link', 'add_artifact_link': Optional comment to include with the link.",
          "type": [
            "string",
            "null"
          ]
        },
        "commitId": {
          "default": null,
          "description": "For 'add_artifact_link': The commit SHA. Required when linkType is 'Fixed in Commit'.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "default": null,
          "description": "For 'link', 'unlink': The ID of the work item to link/unlink."
        },
        "linkToId": {
          "default": null,
          "description": "For 'link': The ID of the work item to link to."
        },
        "linkType": {
          "default": null,
          "description": "For 'link'/'unlink': type of work item link, defaults to 'related'. For 'add_artifact_link': type of artifact link, defaults to 'Branch'. Valid values: 'Branch', 'Fixed in Commit', 'Pull Request', 'Build', 'Found in build', 'Integrated in build', 'Wiki'.",
          "type": [
            "string",
            "null"
          ]
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "pageId": {
          "default": null,
          "description": "For 'add_artifact_link': The numeric ID of the wiki page. Use when the page path is not known; the path will be resolved automatically. Required when linkType is 'Wiki' and pagePath is not provided."
        },
        "pagePath": {
          "default": null,
          "description": "For 'add_artifact_link': The path of the wiki page (e.g., '/My Page'). Required when linkType is 'Wiki' and pageId is not provided.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "default": null,
          "description": "For 'link', 'unlink', 'add_artifact_link': The name or ID of the Azure DevOps project that contains the work item.",
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "default": null,
          "description": "For 'link_to_pull_request': The project ID (GUID) of the work item's project. For 'add_artifact_link': The project ID (GUID) containing the artifact (Git artifacts).",
          "type": [
            "string",
            "null"
          ]
        },
        "pullRequestId": {
          "default": null,
          "description": "For 'link_to_pull_request': The pull request ID. For 'add_artifact_link': The pull request ID when linkType is 'Pull Request'."
        },
        "pullRequestProjectId": {
          "default": null,
          "description": "For 'link_to_pull_request': Optional project ID containing the pull request. Defaults to the work item's project ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryId": {
          "default": null,
          "description": "For 'link_to_pull_request': The repository ID (GUID) of the pull request. For 'add_artifact_link': The repository ID (GUID) containing the artifact.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "default": null,
          "description": "For 'unlink': Optional URL of the link to remove. If omitted, all links of the specified type are removed.",
          "type": [
            "string",
            "null"
          ]
        },
        "wikiId": {
          "default": null,
          "description": "For 'add_artifact_link': The wiki ID (GUID). Required when linkType is 'Wiki'.",
          "type": [
            "string",
            "null"
          ]
        },
        "workItemId": {
          "default": null,
          "description": "For 'link_to_pull_request', 'add_artifact_link': The ID of the work item."
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "wit_work_item_link_write",
    "readOnly": false,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-wit_work_item_write",
    "namespacedName": "ado/wit_work_item_write",
    "source": "mcp",
    "title": "wit_work_item_write",
    "description": "Write operations on Azure DevOps work items. Use 'action' to choose: 'create' (create a new work item), 'update' (update fields on a work item), 'update_batch' (update multiple work items in one call), 'add_child' (create child work items under a parent).",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'create', 'update', 'update_batch', 'add_child'.",
          "type": "string"
        },
        "batchUpdates": {
          "default": null,
          "description": "For 'update_batch': A JSON array of batch update operations. Each entry includes operation, work item ID, field path, and value. Must be an array. Example: [{\"id\":123,\"op\":\"Replace\",\"path\":\"/fields/System.State\",\"value\":\"Active\"}]. Do not pass this value as a JSON-encoded string or as a single object.",
          "items": {
            "properties": {
              "format": {
                "description": "The format of the field value. Use 'Markdown' for multiline HTML fields containing markdown content (Description, ReproSteps, AcceptanceCriteria, etc.) so AzDO renders them as markdown. Omit for plain-text fields (Title, Tags) and short single-line fields -- AzDO rejects the markdown hint on those with 'Operation of changing value type is not supported'. When omitted, the value is stored as-is and the field's native rendering applies.",
                "enum": [
                  "Markdown",
                  "Html"
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "The ID of the work item to update."
              },
              "op": {
                "description": "The operation to perform on the field."
              },
              "path": {
                "description": "The path of the field to update, e.g., '/fields/System.Title'.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "description": "The new value for the field. Accepts strings, numbers, booleans, or null (e.g. 3 for Priority, \"Active\" for State). This is required for 'Add' and 'Replace' operations, and should be omitted for 'Remove' operations."
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "fields": {
          "default": null,
          "description": "For 'create': A JSON array of field name/value pairs to set on the new work item. Must be an array, even when setting a single field. Example: [{\"name\":\"System.Title\",\"value\":\"My bug\"},{\"name\":\"System.Tags\",\"value\":\"urgent\"}]. Do not pass this value as a JSON-encoded string or as a single object."
        },
        "id": {
          "default": null,
          "description": "For 'update': The ID of the work item to update."
        },
        "items": {
          "default": null,
          "description": "For 'add_child': A JSON array of child work items to create. Must be an array, even when creating a single child. Example: [{\"title\":\"Subtask 1\",\"description\":\"...\"}]. Do not pass this value as a JSON-encoded string or as a single object.",
          "items": {
            "properties": {
              "areaPath": {
                "description": "Optional area path for the child work item.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "description": "The description of the child work item.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "format": {
                "description": "The format of the description field value. Use 'Markdown' if the description contains markdown content; AzDO will render it as markdown. Omit if the description is plain text or HTML. Default is no format hint, which preserves the field's native rendering.",
                "enum": [
                  "Markdown",
                  "Html"
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "iterationPath": {
                "description": "Optional iteration path for the child work item.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "description": "The title of the child work item.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required",
          "type": [
            "string",
            "null"
          ]
        },
        "parentId": {
          "default": null,
          "description": "For 'add_child': The ID of the parent work item to create children under."
        },
        "project": {
          "default": null,
          "description": "The name or ID of the Azure DevOps project. Required for 'create', 'add_child'; optional for 'update'; not used for 'update_batch'.",
          "type": [
            "string",
            "null"
          ]
        },
        "updates": {
          "default": null,
          "description": "For 'update': A JSON array of field update operations to apply to the work item. Must be an array, even when updating a single field. Example: [{\"op\":\"Replace\",\"path\":\"/fields/System.Title\",\"value\":\"Updated title\"}]. Do not pass this value as a JSON-encoded string or as a single object.",
          "items": {
            "properties": {
              "format": {
                "description": "The format of the field value. Use 'Markdown' for multiline HTML fields containing markdown content (Description, ReproSteps, AcceptanceCriteria, etc.) so AzDO renders them as markdown. Omit for plain-text fields (Title, Tags) and short single-line fields -- AzDO rejects the markdown hint on those with 'Operation of changing value type is not supported'. When omitted, the value is stored as-is and the field's native rendering applies.",
                "enum": [
                  "Markdown",
                  "Html"
                ],
                "type": [
                  "string",
                  "null"
                ]
              },
              "op": {
                "description": "The operation to perform on the field."
              },
              "path": {
                "description": "The path of the field to update, e.g., '/fields/System.Title'.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {
                "description": "The new value for the field. Accepts strings, numbers, booleans, or null (e.g. 3 for Priority, \"Active\" for State). This is required for 'Add' and 'Replace' operations, and should be omitted for 'Remove' operations."
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "workItemType": {
          "default": null,
          "description": "For 'create', 'add_child': The work item type, e.g., 'Task', 'Bug', 'User Story'.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "wit_work_item_write",
    "readOnly": false,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-work",
    "namespacedName": "ado/work",
    "source": "mcp",
    "title": "work",
    "description": "Read operations on Azure Boards iterations, team settings, and capacity. Use 'action' to choose: 'list_iterations' (project-wide iteration classification nodes; supports 'depth' and 'excludedIds'), 'list_team_iterations' (iterations assigned to a team; requires 'team'; optional 'timeframe'), 'get_team_settings' (team settings including default iteration, backlog iteration, default area path; requires 'team'), 'get_team_capacity' (capacity for a team in a specific iteration; requires 'team' + 'iterationId'), 'get_iteration_capacities' (capacities across all teams for a specific iteration; requires 'iterationId').",
    "input_schema": {
      "properties": {
        "action": {
          "description": "The operation to perform. One of: 'list_iterations', 'list_team_iterations', 'get_team_settings', 'get_team_capacity', 'get_iteration_capacities'.",
          "type": "string"
        },
        "depth": {
          "default": 2,
          "description": "For 'list_iterations': depth of children to fetch."
        },
        "excludedIds": {
          "default": null,
          "description": "For 'list_iterations': an optional array of iteration IDs, and their children, that should not be returned."
        },
        "iterationId": {
          "default": null,
          "description": "For 'get_team_capacity', 'get_iteration_capacities': the iteration ID to look up. Required"
        },
        "orgName": {
          "default": null,
          "description": "The Azure DevOps organization name. Required.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "The name or ID of the Azure DevOps project.",
          "type": "string"
        },
        "team": {
          "default": null,
          "description": "For 'list_team_iterations', 'get_team_settings', 'get_team_capacity': the name or ID of the Azure DevOps team. Required.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeframe": {
          "default": null,
          "description": "For 'list_team_iterations': the timeframe for which to retrieve iterations. Currently, only 'current' is supported.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action",
        "project"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "work",
    "readOnly": true,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
  },
  {
    "name": "ado-work_capacity_write",
