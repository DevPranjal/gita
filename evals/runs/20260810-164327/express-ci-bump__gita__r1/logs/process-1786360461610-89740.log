            "Completed",
            "NotSet"
          ],
          "type": "string"
        },
        "targetRefName": {
          "default": null,
          "description": "For 'list': Filter pull requests into this target branch (e.g., 'refs/heads/main').",
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "default": 100,
          "description": "For 'list': The maximum number of pull requests to return. For 'get_changes': The maximum number of file changes to return (default 100)."
        },
        "userIsReviewer": {
          "default": null,
          "description": "For 'list': Filter pull requests where a specific user is a reviewer (provide email address). Takes precedence over iAmReviewer.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "mcpServerName": "ado",
    "mcpToolName": "repo_pull_request",
    "readOnly": true,
    "safeForTelemetry": {
      "name": false,
      "inputsNames": false
    }
