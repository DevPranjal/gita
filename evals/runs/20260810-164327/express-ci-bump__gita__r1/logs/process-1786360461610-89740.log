              "type": [
                "object",
                "null"
              ]
            },
            "category": {
              "description": "Category of the entry: Troubleshooting, ImpactAssessment, RootCauseAnalysis, Mitigation, Diagnosis, Monitoring, or Discussion."
            },
            "content": {
              "description": "Body content of the entry — the actual finding, summary, or evidence.",
              "type": "string"
            },
            "contentType": {
              "description": "Format of content. Must be one of: Html, Json, Image, Markdown. Defaults to Markdown when omitted (best for human-readable text). Use Html only for sanitized HTML; Json for structured payloads; Image for base64-encoded images."
            },
            "dataClassificationTag": {
              "description": "Data classification tag for the posted content (e.g., SystemMetadata, CustomerContent, EUII). Required so privacy tooling can correctly handle the entry."
            },
            "dataSource": {
              "description": "Optional logical name of the system or automation that produced the insight (e.g., 'GenevaAutoMitigation'). Defaults to 'IcMMCP' when omitted.",
              "type": [
                "string",
                "null"
              ]
            },
            "importanceLevel": {
              "description": "Routing for the insight. Must be one of:\r\n            - Significant: discussion entry AND included in the incident's AI-generated summary (notable findings worth surfacing).\r\n            - Urgent: discussion entry, AI summary, AND bridge data (critical updates that bridge participants must see).\r\n            For routine notes / progress updates that should appear only as a discussion entry, use the PostDiscussionEntry tool instead."
            },
            "incidentId": {
              "description": "The incident ID the entry is being posted to.",
              "type": "integer"
            },
            "links": {
              "description": "Optional hyperlinks attached to the insight (dashboards, log queries, runbooks).",
              "items": {
                "properties": {
                  "title": {
                    "description": "Display text shown for the link in IcM (e.g., 'Geneva dashboard').",
                    "type": "string"
                  },
                  "url": {
                    "description": "Absolute URL the link points to.",
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "url"
                ],
                "type": "object"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "recommendedActions": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Optional dictionary of recommended actions, keyed by short label (e.g., 'Rollback' -> 'Rollback deployment X').",
              "type": [
                "object",
                "null"
              ]
            },
            "title": {
              "description": "Short human-readable title for the entry (shown as the discussion entry header).",
              "type": "string"
            }
          },
          "required": [
            "category",
            "importanceLevel",
            "incidentId",
            "title",
            "content",
            "dataClassificationTag"
          ],
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    },
